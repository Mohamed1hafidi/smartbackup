{
  "id": null,
  "uid": "smartbackup-main",
  "title": "SmartBackup — Overview",
  "tags": ["smartbackup"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend Up",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "up{job=\"smartbackup-backend\"}",
          "legendFormat": "Backend"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP Requests / minute",
      "gridPos": { "x": 4, "y": 0, "w": 10, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"smartbackup-backend\"}[1m]) * 60",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "JVM Memory Used (MB)",
      "gridPos": { "x": 14, "y": 0, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"smartbackup-backend\", area=\"heap\"} / 1024 / 1024",
          "legendFormat": "Heap MB"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "max": 512,
          "thresholds": {
            "steps": [
              { "value": 0,   "color": "green" },
              { "value": 350, "color": "yellow" },
              { "value": 450, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP Error Rate (4xx / 5xx)",
      "gridPos": { "x": 0, "y": 8, "w": 10, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"smartbackup-backend\", status=~\"4..|5..\"}[5m]) * 60",
          "legendFormat": "{{status}} {{uri}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Response Time (p95, ms)",
      "gridPos": { "x": 10, "y": 8, "w": 10, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{job=\"smartbackup-backend\"}[5m])) * 1000",
          "legendFormat": "p95 ms"
        }
      ]
    }
  ]
}
