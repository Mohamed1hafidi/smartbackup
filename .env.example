# =============================================================================
# SmartBackup — Variables d'environnement
# =============================================================================
# INSTRUCTIONS :
#   1. Copier ce fichier : cp .env.example .env
#   2. Renseigner chaque valeur (ne laisser aucun placeholder en production)
#   3. Ne JAMAIS committer le fichier .env — il est dans .gitignore
#   4. Pour la production, injecter les secrets via les variables d'env
#      de Render (backend) et Vercel (frontend), jamais en clair.
# =============================================================================


# =============================================================================
# BACKEND — Spring Boot / Datasource PostgreSQL (Supabase)
# =============================================================================
# URL JDBC de votre base Supabase.
# Format : jdbc:postgresql://<host>:<port>/<database>?sslmode=require
# Exemple Supabase : jdbc:postgresql://db.xxxx.supabase.co:5432/postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:PORT/DATABASE

# Identifiants de connexion à la base Supabase
# Trouvables dans : Supabase Dashboard > Project Settings > Database
SPRING_DATASOURCE_USERNAME=your_supabase_db_username
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password

# Profil Spring actif : "dev" (PostgreSQL local via Docker Compose) | "prod" (Supabase) | "test"
SPRING_PROFILES_ACTIVE=dev


# =============================================================================
# SÉCURITÉ — JWT (JSON Web Tokens)
# =============================================================================
# Secret de signature JWT — MINIMUM 32 caractères alphanumériques + spéciaux
# Générer avec : openssl rand -base64 48
JWT_SECRET=your_jwt_secret_minimum_32_chars_replace_in_production

# Durée de validité du token d'accès en millisecondes
# 86400000 = 24 heures | 3600000 = 1 heure
JWT_EXPIRATION_MS=86400000

# Durée de validité du refresh token en millisecondes
# 604800000 = 7 jours
JWT_REFRESH_EXPIRATION_MS=604800000


# =============================================================================
# STOCKAGE — Cloudflare R2 (API compatible S3)
# =============================================================================
# Endpoint R2 de votre compte Cloudflare
# Format : https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Trouvable dans : Cloudflare Dashboard > R2 > Overview
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Clé d'accès R2 (depuis Cloudflare > R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your_r2_access_key_id

# Clé secrète R2 — NE JAMAIS exposer côté frontend
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Nom du bucket R2 (doit exister et être configuré en privé)
R2_BUCKET_NAME=smartbackup-files

# Région R2 — toujours "auto" pour Cloudflare R2
R2_REGION=auto

# Durée de validité des URLs signées (en secondes)
# 3600 = 1 heure (recommandé pour les téléchargements)
R2_PRESIGNED_URL_EXPIRY_SECONDS=3600


# =============================================================================
# CONFIGURATION APPLICATIVE
# =============================================================================
# Taille maximale d'un fichier uploadable (en Mo)
APP_MAX_FILE_SIZE_MB=50

# Types MIME autorisés pour l'upload (séparés par des virgules)
APP_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,application/zip,application/x-zip-compressed,application/json

# Nombre maximum de fichiers par utilisateur (0 = illimité)
APP_MAX_FILES_PER_USER=100

# URL du frontend (pour CORS et les liens dans les emails)
APP_FRONTEND_URL=http://localhost:5173


# =============================================================================
# NOTIFICATIONS - Email (SendGrid SMTP)
# =============================================================================
# Activer l'envoi d'emails de notification (true | false)
APP_EMAIL_NOTIFICATIONS_ENABLED=false

# Adresse expediteur des emails
APP_NOTIFICATION_FROM_EMAIL=no-reply@smartbackup.local

# Limite quotidienne d'emails par utilisateur
APP_NOTIFICATION_MAX_EMAILS_PER_DAY=5

# SMTP SendGrid : host smtp.sendgrid.net, port 587
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587

# SendGrid : username = "apikey", password = votre cle API SendGrid
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key

# Niveau de logging : TRACE | DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO


# =============================================================================
# FRONTEND — Vite (variables exposées au navigateur, préfixe VITE_ obligatoire)
# =============================================================================
# URL de base de l'API backend
# En développement local : http://localhost:8080
# En production : URL publique de votre instance Render
VITE_API_BASE_URL=http://localhost:8080

# Nom de l'application (affiché dans le titre et les méta)
VITE_APP_NAME=SmartBackup

# Version affichée dans le footer (optionnel)
VITE_APP_VERSION=1.0.0

# Activer les logs de débogage côté frontend (true | false)
VITE_DEBUG=false


# =============================================================================
# DOCKER COMPOSE — Base de données locale (dev uniquement)
# =============================================================================
# Ces variables sont utilisées par l'image postgres dans docker-compose.yml
# En production, utiliser Supabase — ces variables sont ignorées.
POSTGRES_DB=smartbackup
POSTGRES_USER=smartbackup
POSTGRES_PASSWORD=smartbackup_local_password_change_me

# Port local exposé par le conteneur PostgreSQL
POSTGRES_LOCAL_PORT=5432


# =============================================================================
# MONITORING — Prometheus / Grafana (post-MVP, optionnel)
# =============================================================================
# Activer l'endpoint Actuator/Prometheus (/actuator/prometheus)
MANAGEMENT_ENDPOINTS_ENABLED=false

# Mot de passe Grafana (admin par défaut en local)
GRAFANA_ADMIN_PASSWORD=admin_local_only

# Cloudflare Worker — Secret partagé pour le déclenchement du scheduler
SCHEDULER_SECRET=your_strong_scheduler_secret_here
